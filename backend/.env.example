PORT=5000
MONGODB_URI=mongodb://localhost:27017/library_iiitsurat
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d

# Password reset link in emails — must be a PUBLIC URL for “open on any phone / any network”.
# Production: https://your-app.onrender.com (or set CLIENT_URL to your custom domain).
# On Render, RENDER_EXTERNAL_URL is auto-set; CLIENT_URL overrides it if you use a custom domain.
# Local dev only: http://localhost:5173 or http://YOUR_LAN_IP:5173 for same-WiFi phone testing.
# CLIENT_URL=https://your-app.onrender.com

# UPI: merchant VPA shown on the student Pay page (QR + copy). Librarian confirms in Payment Overview.
UPI_MERCHANT_VPA=your.library@ybl
UPI_MERCHANT_NAME=IIIT Surat Library

# Email reminders (due tomorrow + overdue). Use Gmail App Password or any SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="IIIT Surat Library" <your_email@gmail.com>
EMAIL_APP_NAME=IIIT Surat Library
# Optional: SMTP_FORCE_HOST_TRANSPORT=true — use host/port instead of Nodemailer "gmail" service (debug only)
# Optional: SMTP_USE_GMAIL_SERVICE=true — force "gmail" service even for non-Gmail hosts (rare)

# Daily cron uses the SERVER clock (Render is often UTC). Default 09:00 server time.
# Example for ~09:00 India time (IST = UTC+5:30): use 03:30 UTC →
# DUE_REMINDER_CRON=30 3 * * *

# Optional: POST /api/internal/due-reminders with header x-cron-secret (for Render free / external cron)
# CRON_SECRET=long_random_string
